<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="chiku.liu.mapper.UserMapper">

    <insert id="insert">
        insert into day.user(username, age, phone, create_time)
        values (#{userName},#{age},#{phone},#{createTime});
    </insert>
    <delete id="deleteById">
        delete
        from day.user
        where id = #{id};
    </delete>
</mapper>